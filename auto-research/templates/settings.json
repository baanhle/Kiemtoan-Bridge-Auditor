{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(/**)",
      "Edit(/auto-research/**)",
      "Write(/auto-research/**)",
      "Glob",
      "Grep",
      "Bash(python:*)",
      "Bash(python.exe:*)",
      "Bash(py:*)",
      "Bash(pip:*)",
      "Bash(python -m pip:*)",
      "Bash(pandoc:*)",
      "Bash(latexmk:*)",
      "Bash(abaqus:*)",
      "Bash(ccx:*)",
      "WebFetch(domain:api.openalex.org)",
      "WebFetch(domain:api.semanticscholar.org)",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:export.arxiv.org)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:api.unpaywall.org)",
      "WebFetch(domain:doi.org)",
      "WebSearch",
      "Skill",
      "Task",
      "mcp__claude-in-chrome__*"
    ],
    "deny": [
      "Read(/**/.env)",
      "Bash(rm -rf:*)",
      "Bash(del /s:*)",
      "Bash(Remove-Item -Recurse:*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "env": {
    "AUTO_RESEARCH_ROOT": "D:/Research",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  }
}